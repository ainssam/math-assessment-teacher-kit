# 웹 개발 서버가 연결할 로컬 API입니다.
API_ORIGIN=http://127.0.0.1:8010
MATH_ASSESSMENT_API_PORT=8010
MATH_ASSESSMENT_WEB_PORT=3100

# M2에서 생성할 읽기 전용 서비스 데이터의 위치입니다.
MATH_ASSESSMENT_PUBLISH_DB=data/publish/math_assessment_catalog.sqlite

# 방문자 수 연동은 기본으로 꺼져 있습니다. 별도 운영 환경에서만 값을 지정합니다.
MATH_ASSESSMENT_COUNTER_NAMESPACE=
MATH_ASSESSMENT_COUNTER_ORIGIN=
NEXT_PUBLIC_MATH_ASSESSMENT_ENABLE_ANALYTICS=0
